# Clave de NASA FIRMS API. No se necesita para levantar la infraestructura.
MAP_KEY=replace-with-your-firms-map-key

# Credenciales locales. scripts/prepare-env.ps1 las genera en .env sin reemplazar MAP_KEY.
MONGO_ROOT_USER=firms_admin
MONGO_ROOT_PASSWORD=generate-with-scripts-prepare-env
MINIO_ROOT_USER=firms_minio
MINIO_ROOT_PASSWORD=generate-with-scripts-prepare-env

# Configuración de servicios publicados en localhost.
MONGO_PORT=27017
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
SPARK_MASTER_UI_PORT=8080
SPARK_WORKER_UI_PORT=8081
